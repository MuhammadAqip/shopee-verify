def check_number(cookie, phone):
    """Cek akun + apakah nomor fresh/bisa dipakai.

    Return dict:
      ok            : True kalau nomor siap dipakai
      username / old_phone
      need_captcha  : bool
      channels      : [int] channel yang tersedia
      reason        : pesan error kalau ok=False
      seed, cp
    """
    with Session(cookie) as s:
        acc = s.account_info()
        if acc.get("err") not in (0, None):
            return {"ok": False,
                    "reason": f"Sesi cookie tidak valid (error {acc.get('err')})."}
        out = {"ok": False,
               "username": acc.get("username") or "?",
               "old_phone": acc.get("phone") or "?"}

        ini = s.init_change(phone)
        if ini.get("err") != 0:
            out["reason"] = error_text(ini.get("err"))
            return out
        if ini.get("ivs"):
            out["reason"] = ("Akun ini minta verifikasi identitas (IVS). "
                             "Ganti nomor diblokir untuk akun ini.")
            return out
        if ini.get("ongoing"):
            out["reason"] = (f"Akun masih punya permintaan ganti nomor yang "
                             f"menggantung ke {ini['ongoing']}. Tunggu / selesaikan dulu.")
            return out

        st = s.settings(phone)
        if st.get("err") != 0:
            out["reason"] = error_text(st.get("err"))
            return out

        chans = [c for c in (st.get("channels") or []) if c in CHANNEL_NAME]
        if not chans:
            out["reason"] = "Shopee tidak menawarkan channel OTP untuk nomor ini."
            return out

        out.update({
            "ok": True,
            "need_captcha": bool(st.get("need_captcha")),
            "channels": chans,
            "preferred": st.get("preferred"),
            "seed": st.get("seed") or "",
            "cp": ini.get("cp") or "",
            "phone": phone,
        })
        return out


def request_otp(cookie, phone, cp, seed, channel):
    """Kirim OTP di channel pilihan. Return dict ok/trk/reason."""
    with Session(cookie) as s:
        r = s.send_vcode(phone, seed, channel)
        if r.get("err") == 0:
            return {"ok": True, "trk": r.get("trk"),
                    "delivery": r.get("delivery") or channel}
        return {"ok": False, "reason": error_text(r.get("err")),
                "channels": r.get("channels") or []}


def commit_change(cookie, phone, cp, code):
    """verify + commit. Return dict ok/new_phone/reason."""
    with Session(cookie) as s:
        v = s.verify_vcode(phone, code, cp)
        if v.get("err") != 0:
            return {"ok": False, "reason": error_text(v.get("err"))}
        vt = v.get("vt") or ""
        if not vt:
            return {"ok": False, "reason": "vcode_token kosong dari Shopee."}

        c = s.commit(phone, cp, vt)
        if c.get("err") != 0:
            if c.get("err") == "svc_null" or c.get("err") == "no_webpack":
                return {"ok": False,
                        "reason": "Modul Shopee tidak ter-load (webpack belum siap). Coba lagi."}
            return {"ok": False, "reason": error_text(c.get("err")),
                    "detail": c.get("ex")}

        info = s.account_info()
        return {"ok": True,
                "new_phone": info.get("phone") or phone,
                "username": info.get("username") or "?",
                "verified": info.get("verified")}
