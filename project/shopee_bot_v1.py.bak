def cmd_admin(m: Message):
    if m.from_user.id not in ADMIN_IDS and ADMIN_IDS != {0}:
        bot.reply_to(m, "❌ Bukan admin.")
        return
    bot.reply_to(m, f"""🔧 <b>Admin Panel</b>

Cookie: <code>{len(POOL.files)}</code> file
Engine: {'✅ ready' if ENGINE._ready else '❌ belum boot'}
User: <code>{ENGINE._jar_key or '-'}</code>

<b>Perintah:</b>
/addcookie — kirim cookie baru
/reloadcookie — muat ulang pool
/stats — statistik""")


@bot.message_handler(commands=["addcookie"])
def cmd_addcookie(m: Message):
    if m.from_user.id not in ADMIN_IDS and ADMIN_IDS != {0}:
        return
    bot.reply_to(m, "Kirim isi cookie (satu baris, format <code>name=value; name2=value2</code>)")


@bot.message_handler(commands=["reloadcookie"])
def cmd_reload(m: Message):
    if m.from_user.id not in ADMIN_IDS and ADMIN_IDS != {0}:
        return
    POOL.reload()
    ENGINE._jar_key = None
    bot.reply_to(m, f"✅ Pool di-reload: {len(POOL.files)} cookie")


def main():
    log.info("bot starting... cookies=%d", len(POOL.files))
    threading.Thread(target=lambda: (ENGINE.ensure(), log.info("engine warm")),
                     daemon=True).start()
    bot.infinity_polling(timeout=30, long_polling_timeout=25)


if __name__ == "__main__":
    main()
