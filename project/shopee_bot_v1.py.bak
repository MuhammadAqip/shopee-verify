@bot.callback_query_handler(func=lambda c: c.data.startswith("buy_"))
def on_buy(c):
    amount = int(c.data.split("_")[1])
    bot.answer_callback_query(c.id, "Menyiapkan QRIS...")
    # TODO: integrate GPM QRIS
    bot.send_message(c.message.chat.id,
                     f"💳 Topup <b>Rp {amount:,}</b>\n\n"
                     f"<i>Integrasi QRIS GPM menyusul — flow sudah siap di apaja-clone/app/services/gpm.py</i>")


@bot.callback_query_handler(func=lambda c: c.data == "topup")
def on_topup_cb(c):
    bot.answer_callback_query(c.id)
    cmd_topup(c.message)


