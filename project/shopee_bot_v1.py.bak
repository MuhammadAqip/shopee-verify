# ============ DB ============
_db_lock = threading.Lock()


def _load_db() -> dict:
    if DB_PATH.exists():
        try:
            return json.loads(DB_PATH.read_text())
        except Exception:
            pass
    return {"users": {}, "orders": {}, "stats": {"total_checks": 0}}


def _save_db(db: dict) -> None:
    tmp = DB_PATH.with_suffix(".tmp")
    tmp.write_text(json.dumps(db, indent=1, ensure_ascii=False))
    tmp.replace(DB_PATH)


def get_user(uid: int) -> dict:
    with _db_lock:
        db = _load_db()
        u = db["users"].get(str(uid))
        if not u:
            u = {"id": uid, "saldo": 0, "created": int(time.time()),
                 "total_checks": 0, "name": ""}
            db["users"][str(uid)] = u
            _save_db(db)
        return dict(u)


def upd_user(uid: int, **kw) -> dict:
    with _db_lock:
        db = _load_db()
        u = db["users"].setdefault(str(uid), {"id": uid, "saldo": 0,
                                              "created": int(time.time()),
                                              "total_checks": 0, "name": ""})
        u.update(kw)
        _save_db(db)
        return dict(u)


def add_saldo(uid: int, amount: int) -> int:
    with _db_lock:
        db = _load_db()
        u = db["users"].setdefault(str(uid), {"id": uid, "saldo": 0,
                                              "created": int(time.time()),
                                              "total_checks": 0, "name": ""})
        u["saldo"] = int(u.get("saldo", 0)) + amount
        _save_db(db)
        return u["saldo"]


def charge(uid: int, n: int) -> tuple[bool, int]:
    """Potong saldo n*PRICE. Return (ok, sisa)."""
    cost = n * PRICE_PER_CHECK
    with _db_lock:
        db = _load_db()
        u = db["users"].setdefault(str(uid), {"id": uid, "saldo": 0,
                                              "created": int(time.time()),
                                              "total_checks": 0, "name": ""})
        cur = int(u.get("saldo", 0))
        if cur < cost:
            return False, cur
        u["saldo"] = cur - cost
        u["total_checks"] = int(u.get("total_checks", 0)) + n
        db["stats"]["total_checks"] = int(db["stats"].get("total_checks", 0)) + n
        _save_db(db)
        return True, u["saldo"]


# ============ COOKIE POOL ============
class CookiePool:
    """Kelola cookie; rotasi saat kena rate limit."""

    def __init__(self):
        self.files: list[Path] = []
        self.idx = 0
        self.used = 0
        self.reload()

    def reload(self):
        self.files = [CK_MAIN] if CK_MAIN.exists() else []
        if COOKIE_DIR.exists():
            self.files += [p for p in sorted(COOKIE_DIR.glob("*.txt"))
                           if p.stat().st_size > 100]
        self.idx = 0
        self.used = 0

    def current(self) -> Path | None:
        if not self.files:
            return None
        return self.files[self.idx % len(self.files)]

    def next(self) -> Path | None:
        if not self.files:
            return None
        self.idx = (self.idx + 1) % len(self.files)
        self.used = 0
        return self.current()

    def add(self, path: Path):
        self.files.append(path)
        self.idx = len(self.files) - 1
        self.used = 0


POOL = CookiePool()


def load_jar(path: Path) -> dict:
    jar = {}
    for seg in path.read_text().replace("\n", " ").split(";"):
        seg = seg.strip()
        if seg and "=" in seg:
            k, v = seg.split("=", 1)
            jar[k.strip()] = v
    return jar


# ============ ENGINE ============
class Engine:
    """Satu Chromium hidup, dipakai ulang lintas request."""

    def __init__(self):
        self._lock = threading.Lock()
        self._pw = None
        self._b = None
        self._ctx = None
        self._page = None
        self._jar_key = None
        self._ready = False

    def _boot(self):
        from playwright.sync_api import sync_playwright
        self._pw = sync_playwright().start()
        self._b = self._pw.chromium.launch(headless=True, args=[
            "--no-sandbox", "--disable-dev-shm-usage",
            "--disable-blink-features=AutomationControlled",
            "--disable-gpu", "--disable-extensions",
        ])
        self._ready = True
        log.info("chromium booted")

    def _new_context(self, jar: dict):
        from phone_batch2 import UA  # reuse konstanta
        if self._ctx:
            try:
                self._ctx.close()
            except Exception:
                pass
        self._ctx = self._b.new_context(
            user_agent=UA, locale="id-ID",
            viewport={"width": 1366, "height": 900},
            timezone_id="Asia/Jakarta")
        self._page = self._ctx.new_page()
        try:
            self._ctx.add_cookies([{"name": k, "value": v,
                                    "domain": ".shopee.co.id", "path": "/",
                                    "secure": True, "sameSite": "None"}
                                   for k, v in jar.items()])
        except Exception:
            pass
        cdp = self._ctx.new_cdp_session(self._page)
        cdp.send("Network.enable")
        for k, v in jar.items():
            try:
                cdp.send("Network.setCookie", {"name": k, "value": v,
                                               "domain": ".shopee.co.id",
                                               "path": "/", "secure": True})
            except Exception:
                pass
        self._page.goto("https://shopee.co.id/",
                        wait_until="domcontentloaded", timeout=60000)
        self._page.wait_for_timeout(5000)
        uid = self._page.evaluate("""async () => {
            try {
                const r = await fetch('/api/v4/account/basic/get_account_info',
                                      {credentials:'include'});
                const j = await r.json();
                return (j && j.data && j.data.userid) || 0;
            } catch(e) { return 0; }
        }""")
        self._jar_key = jar.get("SPC_U")
        log.info("context ready uid=%s", uid)
        return bool(uid)

    def ensure(self) -> bool:
        """Pastikan browser + cookie siap. TIDAK pakai lock (dipanggil dalam lock check)."""
        if not self._ready:
            self._boot()
        p = POOL.current()
        if not p:
            return False
        jar = load_jar(p)
        key = jar.get("SPC_U")
        if self._page and self._jar_key == key:
            return True
        return self._new_context(jar)

    def check(self, phone: str) -> dict:
        """Cek satu nomor. Return dict dengan verdict."""
        with self._lock:
            if not self.ensure():
                return {"phone": phone, "verdict": "NO_COOKIE"}
            from phone_batch2 import CHECK_JS, verdict_of
            try:
                r = self._page.evaluate(CHECK_JS, {"phone": phone})
            except Exception as e:
                return {"phone": phone, "verdict": "ERROR", "err": str(e)}

            if r.get("exist_raw", {}).get("error") == 90309999 or r.get("blocked"):
                log.warning("rate limit, rotate")
                POOL.next()
                self._jar_key = None
                r2 = self._page.evaluate(CHECK_JS, {"phone": phone}) \
                    if self.ensure() else {"phone": phone, "blocked": True}
                if r2.get("blocked"):
                    return {"phone": phone, "verdict": "RATE_LIMITED"}
                r = r2

            v = verdict_of(r)
            user = r.get("user") or {}
            return {
                "phone": phone,
                "verdict": v,
                "username": user.get("username") or "",
                "exist": r.get("exist"),
                "unbind": (r.get("unbind_raw") or {}).get("data"),
            }

    def check_many(self, phones: list[str], on_progress=None) -> list[dict]:
        out = []
        for i, p in enumerate(phones, 1):
            out.append(self.check(p))
            if on_progress:
                try:
                    on_progress(i, len(phones), out[-1])
                except Exception:
                    pass
            time.sleep(0.8)
        return out


ENGINE = Engine()


# ============ FORMAT ============
ICON = {
    "FRESH": "🟢",
    "BISA_UNBIND": "🔵",
    "LOCKED": "🔴",
    "REUSE_LIMIT": "🟠",
    "TERDAFTAR_UNKNOWN": "🟡",
    "RATE_LIMITED": "⏳",
    "ERROR": "⚫",
    "NO_COOKIE": "🚫",
}
LABEL = {
    "FRESH": "Belum terdaftar (fresh)",
    "BISA_UNBIND": "Terdaftar — BISA di-unbind",
    "LOCKED": "Terdaftar — TIDAK bisa unbind",
    "REUSE_LIMIT": "Terdaftar — kena limit pemakaian",
    "TERDAFTAR_UNKNOWN": "Terdaftar — status unbind tidak diketahui",
    "RATE_LIMITED": "Rate limit, coba lagi nanti",
    "ERROR": "Error",
    "NO_COOKIE": "Server belum punya cookie aktif",
}


def fmt_one(r: dict) -> str:
    v = r.get("verdict", "?")
    lines = [f"{ICON.get(v,'·')} <b>{r.get('phone','')}</b>",
             f"├ {LABEL.get(v, v)}"]
    if r.get("username"):
        lines.append(f"├ Akun: <code>{r['username']}</code>")
    ub = r.get("unbind")
    if ub:
        lines.append(f"├ account_status_check_failed: <code>{ub.get('account_status_check_failed')}</code>")
        lines.append(f"└ phone_reuse_limit_check_failed: <code>{ub.get('phone_reuse_limit_check_failed')}</code>")
    return "\n".join(lines)


def esc(s: str) -> str:
    return (str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))


def norm(p: str) -> str:
    d = re.sub(r"\D", "", str(p or ""))
    if not d:
        return ""
    if d.startswith("0"):
        d = "62" + d[1:]
    elif d.startswith("8"):
        d = "62" + d
    elif d.startswith("620"):
        d = "62" + d[3:]
    return d


def extract_phones(text: str) -> list[str]:
    cands = re.findall(r"(?:\+?62|0)?8\d{8,12}", text or "")
    out, seen = [], set()
    for c in cands:
        n = norm(c)
        # nomor Indonesia valid: 62 + 8 + 8..10 digit = 11..13
        if n and 11 <= len(n) <= 13 and n not in seen:
            seen.add(n)
            out.append(n)
    return out


