@bot.message_handler(commands=["cek"])
def cmd_cek(m: Message):
    uid = m.from_user.id
    arg = (m.text or "").split(maxsplit=1)
    phones = []

    if len(arg) > 1:
        phones = extract_phones(arg[1])

    if not phones and m.reply_to_message:
        phones = extract_phones(m.reply_to_message.text or "")

    if not phones:
        bot.reply_to(m, "❌ Tidak ada nomor valid.\n\nContoh: <code>/cek 6281234567890</code>")
        return

    if len(phones) > 50:
        bot.reply_to(m, f"❌ Maks 50 nomor per /cek. Pakai /batch untuk jumlah besar.")
        return

    ok, sisa = charge(uid, len(phones))
    if not ok:
        bot.reply_to(m, f"❌ Saldo kurang.\n\nButuh: <code>{len(phones)*PRICE_PER_CHECK}</code> poin\n"
                        f"Punya: <code>{sisa}</code> poin\n\n/topup untuk isi saldo")
        return

    sent = bot.reply_to(m, f"⏳ Cek {len(phones)} nomor...")
    results = []
    for i, p in enumerate(phones, 1):
        r = ENGINE.check(p)
        results.append(r)
        try:
            bot.edit_message_text(f"⏳ {i}/{len(phones)} — {p}",
                                  chat_id=sent.chat.id, message_id=sent.message_id)
        except Exception:
            pass
        time.sleep(0.6)

    body = "\n\n".join(fmt_one(r) for r in results)
    tail = f"\n\n<b>Sisa saldo:</b> <code>{sisa}</code> poin"
    txt = body + tail
    if len(txt) > 4000:
        # kirim file kalau kepanjangan
        fp = RESULT_DIR / f"cek_{uid}_{int(time.time())}.txt"
        fp.write_text("\n\n".join(
            f"{r['phone']} | {r['verdict']} | {r.get('username','')} | {r.get('unbind')}"
            for r in results))
        bot.edit_message_text(f"✅ Selesai {len(phones)} nomor.\nHasil kepanjangan, dikirim file.",
                              chat_id=sent.chat.id, message_id=sent.message_id)
        bot.send_document(m.chat.id, fp.open("rb"))
    else:
        bot.edit_message_text(txt, chat_id=sent.chat.id, message_id=sent.message_id)


@bot.message_handler(commands=["batch"])
def cmd_batch(m: Message):
    bot.reply_to(m, "📄 Kirim file <b>.txt</b> berisi nomor (satu per baris).\n"
                    "Maks 500 nomor per file.")


@bot.message_handler(content_types=["document"])
def handle_doc(m: Message):
    uid = m.from_user.id
    doc = m.document
    if not doc.file_name.lower().endswith(".txt"):
        bot.reply_to(m, "❌ Cuma file .txt")
        return

    try:
        fi = bot.get_file(doc.file_id)
        raw = bot.download_file(fi.file_path).decode("utf-8", "ignore")
    except Exception as e:
        bot.reply_to(m, f"❌ Gagal unduh: {e}")
        return

    phones = extract_phones(raw)
    if not phones:
        bot.reply_to(m, "❌ Tidak ada nomor valid di file.")
        return
    if len(phones) > 500:
        bot.reply_to(m, f"❌ {len(phones)} nomor, maks 500. Pecah file-nya.")
        return

    ok, sisa = charge(uid, len(phones))
    if not ok:
        bot.reply_to(m, f"❌ Saldo kurang untuk {len(phones)} nomor "
                        f"(butuh {len(phones)*PRICE_PER_CHECK}, punya {sisa}).\n/topup")
        return

    sent = bot.reply_to(m, f"⏳ Batch {len(phones)} nomor dimulai...")
    results = []
    t0 = time.time()
    last_edit = 0

    for i, p in enumerate(phones, 1):
        r = ENGINE.check(p)
        results.append(r)
        now = time.time()
        if now - last_edit > 3 or i == len(phones):
            last_edit = now
            done = len(results)
            fresh = sum(1 for x in results if x["verdict"] == "FRESH")
            unbin = sum(1 for x in results if x["verdict"] == "BISA_UNBIND")
            try:
                bot.edit_message_text(
                    f"⏳ <b>Batch berjalan</b>\n\n"
                    f"Progress: <code>{done}/{len(phones)}</code> ({done*100//len(phones)}%)\n"
                    f"🟢 Fresh: <code>{fresh}</code>\n"
                    f"🔵 Bisa unbind: <code>{unbin}</code>\n"
                    f"⏱ {int(now-t0)}s",
                    chat_id=sent.chat.id, message_id=sent.message_id)
            except Exception:
                pass
        time.sleep(0.6)

    # ringkasan
    from collections import Counter
    c = Counter(r["verdict"] for r in results)
    fp = RESULT_DIR / f"batch_{uid}_{int(time.time())}.txt"
    with fp.open("w") as f:
        f.write(f"# Shopee Phone Check — {datetime.now():%Y-%m-%d %H:%M}\n")
        f.write(f"# Total: {len(results)}\n\n")
        for r in results:
            f.write(f"{r['phone']} | {r['verdict']} | {r.get('username','')}\n")

    summary = f"""✅ <b>Batch selesai</b> — {len(results)} nomor

🟢 Fresh: <code>{c.get('FRESH',0)}</code>
🔵 Bisa unbind: <code>{c.get('BISA_UNBIND',0)}</code>
🔴 Tidak bisa unbind: <code>{c.get('LOCKED',0)}</code>
🟠 Limit reuse: <code>{c.get('REUSE_LIMIT',0)}</code>
⏳ Rate limited: <code>{c.get('RATE_LIMITED',0)}</code>
⚫ Error: <code>{c.get('ERROR',0)}</code>

<b>Sisa saldo:</b> <code>{sisa}</code> poin
<b>Durasi:</b> {int(time.time()-t0)}s"""

    try:
        bot.edit_message_text(summary, chat_id=sent.chat.id, message_id=sent.message_id)
    except Exception:
        bot.send_message(m.chat.id, summary)
    bot.send_document(m.chat.id, fp.open("rb"))


